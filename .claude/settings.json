{
  "model": "opus",
  "autoCompactWindow": 300000,
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Bash(bin/selftest:*)",
      "Bash(./bin/selftest:*)",
      "Bash(bin/doctor:*)",
      "Bash(./bin/doctor:*)",
      "Bash(bin/glossary:*)",
      "Bash(./bin/glossary:*)",
      "Bash(bin/wiki-check:*)",
      "Bash(./bin/wiki-check:*)",
      "Bash(bin/backlink-check:*)",
      "Bash(./bin/backlink-check:*)",
      "Bash(bin/define-check:*)",
      "Bash(./bin/define-check:*)",
      "Bash(bin/hedge-scan:*)",
      "Bash(./bin/hedge-scan:*)",
      "Bash(bin/link-check:*)",
      "Bash(./bin/link-check:*)",
      "Bash(bin/math-hygiene-scan:*)",
      "Bash(./bin/math-hygiene-scan:*)",
      "Bash(bin/orphan-check:*)",
      "Bash(./bin/orphan-check:*)",
      "Bash(bin/scope-estimate-scan:*)",
      "Bash(./bin/scope-estimate-scan:*)",
      "Bash(bin/stale-status-scan:*)",
      "Bash(./bin/stale-status-scan:*)",
      "Bash(bin/gate-stamp:*)",
      "Bash(./bin/gate-stamp:*)",
      "Bash(bin/setup-hooks:*)",
      "Bash(./bin/setup-hooks:*)",
      "Bash(bin/doc check:*)",
      "Bash(./bin/doc check:*)",
      "Bash(bin/doc list:*)",
      "Bash(./bin/doc list:*)",
      "Bash(bin/journal:*)",
      "Bash(./bin/journal:*)",
      "Bash(bin/usage-report:*)",
      "Bash(./bin/usage-report:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/file-home-nudge.py\" --harness claude"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/large-doc-gate-nudge.py\" --harness claude"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/brief-leak-nudge.py\" --harness claude"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/define-check-nudge.py\" --harness claude"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/orphan-check-nudge.py\" --harness claude"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/backlink-check-nudge.py\" --harness claude"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/stale-scan-predispatch.py\" --harness claude"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/gate-dispatch-log.py\" --harness claude"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/lit-search-predispatch.py\" --harness claude"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/lit-search-gate.py\" --harness claude"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/agent-brief-lint.py\" --harness claude"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/askquestion-fanout-nudge.py\" --harness claude"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/guard.py\" --harness claude"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/cd-drift-nudge.py\" --harness claude"
          }
        ]
      },
      {
        "matcher": "WebSearch|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/offline-guard.py\" --harness claude"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/offline-guard.py\" --harness claude"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/coordinator-context.py\" --harness claude --part 1"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/coordinator-context.py\" --harness claude --part 2"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/coordinator-context.py\" --harness claude --part 3"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/durable-ack-guard.py\" --harness claude"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/continue-nudge.py\" --harness claude"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/proactive-friction-nudge.py\" --harness claude"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/proposals-nudge.py\" --harness claude"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/usage-log.py\" --harness claude"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/reflect-on-failure.py\" --harness claude"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/reflect-on-failure.py\" --harness claude"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/usage-log.py\" --harness claude"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/usage-log.py\" --harness claude"
          }
        ]
      }
    ]
  }
}
