#!/usr/bin/env python3
"""Run the workspace without web access, or with it again. The owner's switch.

selftest: yes

  bin/offline on        no web search or fetch, and no downloads from the shell
  bin/offline off       web access as before
  bin/offline status    which it is, and whether every layer agrees (exit 1 if not)
  bin/offline --selftest

Offline mode is for work that must not leave this computer: a colleague's unpublished draft,
a confidential problem. Three layers, switched together:
  * project.toml `[web] offline`, which the offline-guard hook, bin/doc and the agents read;
  * Claude Code: WebSearch and WebFetch move from `permissions.allow` to `permissions.deny`
    in .claude/settings.json (subagents included);
  * Codex: `web_search = "disabled"` in .codex/config.toml.
The change is committed. Start a new agent session afterwards: settings load when a session
starts. Citations that cannot be checked offline are marked "not verified (offline)".
"""
from __future__ import annotations

import contextlib
import io
import json
import re
import subprocess
import sys
import tempfile
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
WEB_TOOLS = ["WebSearch", "WebFetch"]
CODEX_LINE = 'web_search = "disabled"'


def project_offline(root: Path) -> bool:
    try:
        with open(root / "project.toml", "rb") as f:
            return bool(tomllib.load(f).get("web", {}).get("offline", False))
    except (OSError, tomllib.TOMLDecodeError):
        return False


def set_project(root: Path, on: bool) -> None:
    p = root / "project.toml"
    text = p.read_text(encoding="utf-8")
    line = f"offline = {'true' if on else 'false'}"
    if re.search(r"(?m)^\[web\]\s*$", text):
        if re.search(r"(?m)^offline\s*=.*$", text):
            text = re.sub(r"(?m)^offline\s*=.*$", line, text, count=1)
        else:
            text = re.sub(r"(?m)^\[web\]\s*$", f"[web]\n{line}", text, count=1)
    else:
        text = text.rstrip("\n") + ("\n\n[web]\n# true: no web search or fetch, and no downloads "
                                    "from the shell (bin/offline; docs/OWNER.md, \"Web access\").\n"
                                    f"{line}\n")
    p.write_text(text, encoding="utf-8")


def claude_state(root: Path) -> bool | None:
    p = root / ".claude" / "settings.json"
    if not p.is_file():
        return None
    perms = json.loads(p.read_text(encoding="utf-8")).get("permissions", {})
    return all(t in perms.get("deny", []) for t in WEB_TOOLS) and not any(t in perms.get("allow", []) for t in WEB_TOOLS)


def set_claude(root: Path, on: bool) -> None:
    p = root / ".claude" / "settings.json"
    d = json.loads(p.read_text(encoding="utf-8"))
    perms = d.setdefault("permissions", {})
    allow, deny = perms.setdefault("allow", []), perms.get("deny", [])
    if on:
        perms["allow"] = [t for t in allow if t not in WEB_TOOLS]
        perms["deny"] = deny + [t for t in WEB_TOOLS if t not in deny]
    else:
        perms["allow"] = [t for t in WEB_TOOLS if t not in allow] + allow
        perms["deny"] = [t for t in deny if t not in WEB_TOOLS]
        if not perms["deny"]:
            del perms["deny"]
    p.write_text(json.dumps(d, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")


def codex_state(root: Path) -> bool | None:
    p = root / ".codex" / "config.toml"
    if not p.is_file():
        return None
    try:
        return tomllib.loads(p.read_text(encoding="utf-8")).get("web_search") == "disabled"
    except tomllib.TOMLDecodeError:
        return False


def set_codex(root: Path, on: bool) -> None:
    p = root / ".codex" / "config.toml"
    lines = [ln for ln in p.read_text(encoding="utf-8").splitlines() if not ln.startswith("web_search")]
    if on:
        # A top-level key must come before the first [table].
        at = next((i for i, ln in enumerate(lines) if ln.startswith("[")), len(lines))
        lines[at:at] = ["# Offline mode (bin/offline): no web search for the agents.", CODEX_LINE, ""]
    else:
        lines = [ln for ln in lines if ln != "# Offline mode (bin/offline): no web search for the agents."]
    p.write_text("\n".join(lines) + "\n", encoding="utf-8")


def layers(root: Path) -> dict[str, bool]:
    out = {"project.toml": project_offline(root)}
    c, x = claude_state(root), codex_state(root)
    if c is not None:
        out[".claude/settings.json"] = c
    if x is not None:
        out[".codex/config.toml"] = x
    return out


def switch(root: Path, on: bool, commit: bool = True) -> int:
    set_project(root, on)
    if claude_state(root) is not None:
        set_claude(root, on)
    if codex_state(root) is not None:
        set_codex(root, on)
    state = layers(root)
    if any(v != on for v in state.values()):
        print(f"FAIL  not every layer switched: {state}")
        return 1
    files = [f for f in ("project.toml", ".claude/settings.json", ".codex/config.toml") if (root / f).exists()]
    if commit:
        subprocess.run(["git", "commit", "-q", "-m", f"Web access {'off (offline mode)' if on else 'on'}",
                        "--", *files], cwd=root, capture_output=True)
    print(f"PASS  web access is {'OFF (offline)' if on else 'ON'} in {', '.join(state)}.")
    print("Start a new agent session for it to take effect.")
    return 0


def status(root: Path) -> int:
    state = layers(root)
    vals = set(state.values())
    for k, v in state.items():
        print(f"{'offline' if v else 'online':8} {k}")
    if len(vals) > 1:
        print("FAIL  the layers disagree: run bin/offline on (or off) to make them agree")
        return 1
    return 0


def selftest() -> int:
    bad: list[str] = []
    with tempfile.TemporaryDirectory() as t, contextlib.redirect_stdout(io.StringIO()):
        root = Path(t)
        (root / ".claude").mkdir()
        (root / ".codex").mkdir()
        (root / "project.toml").write_text('[project]\nname = "x"\n')
        (root / ".claude" / "settings.json").write_text(json.dumps(
            {"permissions": {"allow": ["WebSearch", "WebFetch", "Bash(bin/doctor:*)"]}}, indent=2))
        (root / ".codex" / "config.toml").write_text('model = "m"\n\n[permissions.p]\nx = "y"\n')
        subprocess.run(["git", "init", "-q"], cwd=root)
        if switch(root, True, commit=False) != 0 or layers(root) != {
                "project.toml": True, ".claude/settings.json": True, ".codex/config.toml": True}:
            bad.append(f"on: {layers(root)}")
        cfg = tomllib.loads((root / ".codex" / "config.toml").read_text())
        if cfg.get("web_search") != "disabled" or cfg["permissions"]["p"]["x"] != "y":
            bad.append("codex: web_search must be top-level, the tables intact")
        perms = json.loads((root / ".claude" / "settings.json").read_text())["permissions"]
        if "Bash(bin/doctor:*)" not in perms["allow"] or "WebSearch" in perms["allow"]:
            bad.append(f"claude allow list: {perms}")
        if status(root) != 0:
            bad.append("status after on")
        switch(root, True, commit=False)
        if (root / ".codex" / "config.toml").read_text().count("web_search") != 1:
            bad.append("on twice must not duplicate the codex line")
        if switch(root, False, commit=False) != 0 or any(layers(root).values()):
            bad.append(f"off: {layers(root)}")
        perms = json.loads((root / ".claude" / "settings.json").read_text())["permissions"]
        if "WebSearch" not in perms["allow"] or "deny" in perms:
            bad.append(f"off restores the allow list: {perms}")
        set_project(root, True)
        if status(root) != 1:
            bad.append("disagreeing layers must fail status")
    for b in bad:
        print("SELFTEST FAIL", b)
    print(f"offline selftest: {'ok' if not bad else f'{len(bad)} failed'}")
    return 1 if bad else 0


if __name__ == "__main__":
    arg = sys.argv[1:]
    if arg == ["--selftest"]:
        sys.exit(selftest())
    if arg == ["on"] or arg == ["off"]:
        sys.exit(switch(ROOT, arg[0] == "on"))
    if arg == ["status"]:
        sys.exit(status(ROOT))
    print(__doc__)
    sys.exit(2)
